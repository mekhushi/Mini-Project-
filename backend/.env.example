PORT=5000

# Database Configuration (MongoDB Atlas or Local MongoDB)
# Note: JustBid includes an automatic resilient local JSON engine if MongoDB is offline
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/justbid?appName=Cluster0"

# Authentication & Security
JWT_SECRET="your_jwt_secret_key_here"
BACKEND_API_KEY="worker-secret-key-for-python-script"
BACKEND_API_URL="http://localhost:5000"

# AI Document & RFP Analysis (Optional: Groq API Key)
VITE_GROQ_API_KEY="your_groq_api_key_here"

# Email Configuration (Optional: Password Reset & Alerts)
EMAIL_SERVICE="gmail"
EMAIL_USERNAME="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"
EMAIL_FROM="noreply@justbid.ch"
